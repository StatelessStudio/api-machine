{
	"root": true,
	"extends": ["./.eslintrc.js"],
	"rules": {
		"no-console": 2,
		"no-debugger": 2
	},
	"overrides": [
		{
			"files": ["examples/**/*.ts", "scripts/**/*.ts"],
			"rules": {
				"@typescript-eslint/no-unused-vars": [
					1,
					{ "argsIgnorePattern": "request|response" }
				],
				"no-console": 0
			}
		}
	]
}
